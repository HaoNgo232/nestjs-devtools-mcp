{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "sourceMap": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@nestjs-devtools-mcp/plugin": ["./packages/plugin/src"],
      "nestjs-devtools-mcp": ["./packages/server/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
