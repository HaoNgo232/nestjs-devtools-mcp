{
  "name": "nestjs-devtools-mcp-monorepo",
  "private": true,
  "description": "Monorepo for NestJS DevTools MCP",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint \"**/*.ts\" --config eslint.config.mjs",
    "format": "prettier --write \"**/*.ts\"",
    "ci": "pnpm run format && pnpm run lint && pnpm run build && pnpm run test"
  },
  "workspaces": [
    "packages/*",
    "demo-app"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "unrs-resolver"
    ]
  },
  "version": "0.2.0"
}
